# Copy to .env (never commit .env). All secrets may instead be supplied as
# process environment variables, which is the recommended production path.
#
# One app credential per bot. Bot "default" is the minimum required entry.
FEISHU_GATEWAY_DEFAULT_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_GATEWAY_DEFAULT_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: use the international Lark domain instead of the Feishu domain.
# FEISHU_GATEWAY_DEFAULT_DOMAIN=lark
#
# Optional: a second bot named "ops".
# FEISHU_GATEWAY_OPS_APP_ID=cli_yyyyyyyyyyyyyyyy
# FEISHU_GATEWAY_OPS_APP_SECRET=yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# ---------------------------------------------------------------------------
# Dedicated TEST credentials for the two P0 end-to-end tests (docs/E2E.md).
# Use a SEPARATE Feishu test app and a SEPARATE test LLM route.
# Never commit real values; never reuse production credentials.
# ---------------------------------------------------------------------------
# P0-A: real commercial LLM (OpenAI-compatible endpoint)
# FEISHU_GATEWAY_TEST_LLM_KEY=
# FEISHU_GATEWAY_TEST_LLM_BASE_URL=https://<provider>/v1
# FEISHU_GATEWAY_TEST_LLM_MODEL=<model-id>
#
# P0-B: real Feishu test tenant
# FEISHU_GATEWAY_TEST_ALLOWLIST=ou_xxxxxxxxxxxxxxxx
# FEISHU_GATEWAY_TEST_CHAT_ID=oc_xxxxxxxxxxxxxxxx
# FEISHU_GATEWAY_TEST_USER_ACCESS_TOKEN=
#
# Optional: the string the 3-turn test asks the model to remember.
# E2E_TOKEN=GBM-7429
