{
  "name": "dsh-plugin-feishu-gateway",
  "version": "0.2.0-rc.11",
  "description": "Independent DSH Cordis plugin that bridges Feishu/Lark direct messages to native DSH Sessions over a WebSocket long connection.",
  "keywords": [
    "dsh",
    "cordis",
    "feishu",
    "lark",
    "gateway",
    "plugin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./testing": {
      "types": "./lib/types/testing/index.d.ts",
      "default": "./lib/testing/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "docs",
    "profiles"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "https-proxy-agent": "5.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "3.2.7",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node web-admin/scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo": "node scripts/demo.mjs",
    "verify": "pnpm run typecheck && pnpm run build && pnpm run test && node --test web-admin/test/*.test.mjs && node --check web-admin/lib/client.js",
    "pack": "pnpm pack --pack-destination dist && pnpm --dir web-admin pack --pack-destination ../dist",
    "e2e:preflight": "node scripts/e2e/run.mjs preflight --llm real --feishu live",
    "e2e:mock": "node scripts/e2e/run.mjs session-bridge --llm mock",
    "e2e:real-llm": "node scripts/e2e/run.mjs session-bridge --llm real",
    "e2e:daemon-smoke": "node scripts/e2e/run.mjs daemon-smoke",
    "e2e:feishu": "node scripts/e2e/run.mjs feishu --llm real"
  },
  "packageManager": "pnpm@12.18.0"
}
